const button = document.getElementById("mehrButton");
const text = document.getElementById("mehrText");

button.addEventListener("click", function() {

    if (text.style.display === "none") {

        text.style.display = "block";
        button.textContent = "Weniger anzeigen";

    } else {

        text.style.display = "none";
        button.textContent = "Mehr über mich";

    }

});


// NOVO: Letnica v nogi se posodobi sama

